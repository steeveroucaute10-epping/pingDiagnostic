[Unit]
Description=Pi Monitor API - HTTP API for dashboard (reads from pi_monitor DB)
After=network-online.target pi-monitor.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/.nanobot/workspace/skills/pi-network-monitor
ExecStart=/home/pi/nanobot-venv/bin/python -m pi_monitor.api --host 0.0.0.0 --port 5001
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
